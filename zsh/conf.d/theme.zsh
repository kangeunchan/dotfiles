# Shared terminal palette.
typeset -g KC_COLOR_BACKGROUND='#1C1F21'
typeset -g KC_COLOR_FOREGROUND='#DCDDDD'
typeset -g KC_COLOR_PANEL='#383A3D'
typeset -g KC_COLOR_GREEN='#A0D07D'
typeset -g KC_COLOR_CYAN='#49B7D7'

# ANSI text styles used by the greeting.
typeset -g KC_ANSI_RESET=$'\e[0m'
typeset -g KC_ANSI_MUTED=$'\e[38;2;112;112;112m'
typeset -g KC_ANSI_VALUE=$'\e[38;2;220;221;221m'
typeset -g KC_ANSI_ACCENT=$'\e[1;38;2;73;183;215m'
typeset -g KC_ANSI_HIGHLIGHT=$'\e[1;38;2;245;196;67m'

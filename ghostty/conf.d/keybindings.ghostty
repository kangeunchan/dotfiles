# Keyboard ownership: Ghostty uses Command; tmux and Neovim use Control/Space.
# Physical key names keep shortcuts stable while the Korean IME is active.
keybind = clear

# Preserve ASCII control characters by physical position in either input source.
keybind = ctrl+key_a=text:\x01
keybind = ctrl+key_b=text:\x02
keybind = ctrl+key_c=text:\x03
keybind = ctrl+key_d=text:\x04
keybind = ctrl+key_e=text:\x05
keybind = ctrl+key_f=text:\x06
keybind = ctrl+key_g=text:\x07
keybind = ctrl+key_h=text:\x08
keybind = ctrl+key_i=text:\x09
keybind = ctrl+key_j=text:\x0a
keybind = ctrl+key_k=text:\x0b
keybind = ctrl+key_l=text:\x0c
keybind = ctrl+key_m=text:\x0d
keybind = ctrl+key_n=text:\x0e
keybind = ctrl+key_o=text:\x0f
keybind = ctrl+key_p=text:\x10
keybind = ctrl+key_q=text:\x11
keybind = ctrl+key_r=text:\x12
keybind = ctrl+key_s=text:\x13
keybind = ctrl+key_t=text:\x14
keybind = ctrl+key_u=text:\x15
keybind = ctrl+key_v=text:\x16
keybind = ctrl+key_w=text:\x17
keybind = ctrl+key_x=text:\x18
keybind = ctrl+key_y=text:\x19
keybind = ctrl+key_z=text:\x1a

# App and configuration.
keybind = super+comma=open_config
keybind = super+shift+comma=reload_config
keybind = super+shift+key_p=toggle_command_palette
keybind = super+shift+key_i=inspector:toggle
keybind = super+enter=toggle_fullscreen
keybind = super+key_q=quit

# Clipboard and selection.
keybind = performable:super+key_c=copy_to_clipboard:mixed
keybind = super+key_v=paste_from_clipboard
keybind = super+shift+key_v=paste_from_selection
keybind = super+key_a=select_all
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = shift+page_up=adjust_selection:page_up
keybind = shift+page_down=adjust_selection:page_down
keybind = shift+home=adjust_selection:home
keybind = shift+end=adjust_selection:end

# Search and scrollback.
keybind = super+key_f=start_search
keybind = super+key_e=search_selection
keybind = super+key_g=navigate_search:next
keybind = super+shift+key_g=navigate_search:previous
keybind = super+shift+key_f=end_search
keybind = escape=end_search
keybind = super+home=scroll_to_top
keybind = super+end=scroll_to_bottom
keybind = super+page_up=scroll_page_up
keybind = super+page_down=scroll_page_down
keybind = super+arrow_up=jump_to_prompt:-1
keybind = super+arrow_down=jump_to_prompt:1
keybind = super+key_k=clear_screen

# Font size.
keybind = super+equal=increase_font_size:1
keybind = super+shift+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+digit_0=reset_font_size

# Windows, tabs, and Ghostty-native splits.
keybind = super+key_n=new_window
keybind = super+key_t=new_tab
keybind = super+key_w=close_surface
keybind = super+shift+key_w=close_window
keybind = super+shift+key_t=undo
keybind = super+shift+bracket_left=previous_tab
keybind = super+shift+bracket_right=next_tab
keybind = super+digit_1=goto_tab:1
keybind = super+digit_2=goto_tab:2
keybind = super+digit_3=goto_tab:3
keybind = super+digit_4=goto_tab:4
keybind = super+digit_5=goto_tab:5
keybind = super+digit_6=goto_tab:6
keybind = super+digit_7=goto_tab:7
keybind = super+digit_8=goto_tab:8
keybind = super+digit_9=last_tab
keybind = super+key_d=new_split:right
keybind = super+shift+key_d=new_split:down
keybind = super+alt+arrow_left=goto_split:left
keybind = super+alt+arrow_down=goto_split:down
keybind = super+alt+arrow_up=goto_split:up
keybind = super+alt+arrow_right=goto_split:right
keybind = super+ctrl+arrow_left=resize_split:left,10
keybind = super+ctrl+arrow_down=resize_split:down,10
keybind = super+ctrl+arrow_up=resize_split:up,10
keybind = super+ctrl+arrow_right=resize_split:right,10

# Shell-style word movement.
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
